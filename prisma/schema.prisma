// Prisma schema — TechAdvisor backend.
// Business models are added in later phases. This file intentionally starts
// with datasource + generator only (see ADR 0003); the first migration only
// enables the pgvector extension.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (Fase 1) -----------------------------------------------------------

/** Customer-facing roles. Public registration always creates CUSTOMER. */
enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String?
  role         Role           @default(CUSTOMER)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  carts        Cart[]
  orders       Order[]

  @@map("users")
}

/**
 * Rotating opaque refresh tokens. Only the SHA-256 hash of the token is
 * stored (`tokenHash`); the raw value is shown to the client once at issue
 * time and never logged. Rotation revokes the presented token and issues a
 * new one; reuse of a revoked token revokes the family (theft detection).
 */
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// --- Catalog (Fase 1) --------------------------------------------------------
// Read-only public surface in P1.2 (writes/admin arrive in P1.7).
// Money: INTEGER minor units + ISO 4217 code, never float (see ADR 0007).
// I18n: base columns hold DEFAULT_LOCALE content; translation tables hold
// other locales with fallback to base (see ADR 0008).

/** Lifecycle of a product. The public API only ever returns ACTIVE. */
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id") @db.Uuid
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  documents Document[]
  translations CategoryTranslation[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String        @unique
  name        String
  slug        String        @unique
  description String
  brandId     String        @map("brand_id") @db.Uuid
  brand       Brand         @relation(fields: [brandId], references: [id])
  categoryId  String        @map("category_id") @db.Uuid
  category    Category      @relation(fields: [categoryId], references: [id])
  /** Base price in minor units (see ADR 0007). Always BASE_CURRENCY. */
  priceAmount Int           @map("price_amount")
  /** ISO 4217 code of `priceAmount`. */
  currency    String
  status      ProductStatus @default(DRAFT)
  /** Normalized structured attributes (snake_case keys, see specs/). */
  specs       Json          @default("{}") @db.JsonB
  images      ProductImage[]
  prices      ProductPrice[]
  translations ProductTranslation[]
  documents   Document[]
  chunks      Chunk[]
  inventory   Inventory?
  movements   InventoryMovement[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

/** Fixed price per currency overriding the base price (see ADR 0007). */
model ProductPrice {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency  String
  amount    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, currency])
  @@index([currency])
  @@map("product_prices")
}

model ProductTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

/**
 * Product images stored as https URLs only (no file uploads in this phase).
 * Ordered by `position`; the lowest position is the primary image.
 */
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(2048)
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, position])
  @@map("product_images")
}

/**
 * Stock per product. `productId` is both PK and FK to `products(id)`.
 * `stock` = physical units on hand; `reserved` = units held by open
 * orders/carts. Available = `stock` - `reserved` (never negative: enforced
 * by DB CHECKs `stock >= 0`, `reserved >= 0`, `reserved <= stock`, see the
 * migration SQL — Prisma has no native CHECK support).
 * Every mutation goes through `InventoryService` with conditional UPDATEs,
 * so concurrent reservations can never oversell.
 */
model Inventory {
  productId String   @id @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock     Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory")
}

/**
 * Audit trail of every manual stock adjustment (admin writes, P1.7).
 * One row per adjustment: `delta` is the signed change applied to
 * `inventory.stock` (never to `reserved`), `reason` is the human motive,
 * and `stockAfter` is the resulting physical stock. Rows are append-only:
 * never updated or deleted by application code (see AdminService).
 */
model InventoryMovement {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta      Int
  reason     String   @db.VarChar(280)
  stockAfter Int      @map("stock_after")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

// --- Cart (Fase 1) -----------------------------------------------------------
// Guest carts are keyed by `sessionId` (signed httpOnly `sid` cookie, see ADR
// 0010); user carts by `userId`. At most one cart per user and at most one
// per session: enforced by unique constraints (`@unique` on nullable columns
// is enough in PostgreSQL — NULLs never conflict — plus partial indexes in
// the migration as documentation/backstop). Prices/totals are NEVER stored:
// the cart response is always computed from the DB (see CartService).

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @unique @map("user_id") @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique @map("session_id")
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// --- Orders (Fase 1) ---------------------------------------------------------
// Checkout from the authenticated user cart: prices are frozen into
// `OrderItem.unit_price_amount` (minor units, order currency) and stock is
// reserved atomically at creation (see OrdersService + ADR 0011). Totals are
// always computed server-side from the database — the client only sends the
// cart (implicit) + shipping address. `shipping` is a JSONB snapshot of the
// validated international address (ISO 3166-1 country).

/** Order lifecycle. Only the guarded transitions in `order-status.ts` apply. */
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING_PAYMENT)
  /** ISO 4217 code of `totalAmount` and every item price. */
  currency    String
  /** Frozen total in minor units (sum of item lines at creation). */
  totalAmount Int         @map("total_amount")
  /** Validated shipping address snapshot (see orders.schemas.ts). */
  shipping    Json        @db.JsonB
  items       OrderItem[]
  payments    Payment[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String   @map("product_id") @db.Uuid
  product         Product  @relation(fields: [productId], references: [id])
  qty             Int
  /** Frozen unit price in minor units, in the order currency. */
  unitPriceAmount Int      @map("unit_price_amount")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

// --- Payments (Fase 1) -------------------------------------------------------
// Stripe test-mode charges behind the `PaymentProvider` interface (ADR 0012).
// A Payment mirrors one checkout attempt for an order; the order status itself
// stays the source of truth for fulfillment. `provider` is a free-form string
// (e.g. "stripe") so a second provider needs no schema change.
// `ProcessedWebhookEvent` records every applied webhook `event_id` (UNIQUE)
// so redelivered events are acknowledged without repeating side effects.

/** Lifecycle of one payment attempt. Terminal states never change. */
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  status      PaymentStatus @default(PENDING)
  /** Provider-side reference (Stripe Checkout Session / PaymentIntent id). */
  externalRef String?       @map("external_ref")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([externalRef])
  @@map("payments")
}

model ProcessedWebhookEvent {
  /** Provider event id (e.g. `evt_...`); UNIQUE = idempotency key. */
  eventId   String   @id @map("event_id")
  provider  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_webhook_events")
}

// --- RAG corpus (Fase 2) -----------------------------------------------------
// Source documents and their text chunks live in the same PostgreSQL as the
// rest of the domain (no external vector store, see AGENTS.md §2).
// - `embedding vector(1536)` (default model text-embedding-3-small, ADR
//   0017) is owned entirely by a manual SQL migration: Prisma has no vector
//   type, so it has no counterpart here and is written/read via `$queryRaw`.
//   Each embedded chunk records `embeddingModel`/`embeddingDim` below; never
//   mix models or dimensions in one column (see ADR 0017 §switching models).
// - NO `tsv tsvector` field in the Prisma models: Prisma has no tsvector
//   type, so the `tsv` column is owned entirely by a manual SQL migration
//   (trigger + GIN index, see ADR 0015) and queried via `$queryRaw`.

/** Kind of source document feeding the RAG pipeline. */
enum DocumentType {
  SPEC_SHEET
  MANUAL
  FAQ
  WARRANTY
  REVIEW
  POLICY
}

/** Ingestion lifecycle of a document. */
enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String?        @map("product_id") @db.Uuid
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId  String?        @map("category_id") @db.Uuid
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type        DocumentType
  title       String
  /** BCP 47 locale of the document content (e.g. `es`, `en`). */
  locale      String
  sourceUrl   String?        @map("source_url") @db.VarChar(2048)
  /**
   * Provenance of the document: `manual` for admin-registered sources,
   * `auto:product` for the SPEC_SHEET generated from a product row (see ADR
   * 0019). Combined with `productId` in a unique constraint so each product
   * owns at most one auto-generated document.
   */
  source      String         @default("manual")
  /** Hash of the extracted source text; re-ingest skips when unchanged. */
  contentHash String         @map("content_hash")
  status      DocumentStatus @default(PENDING)
  /** Failure detail when `status` is FAILED; NULL otherwise. */
  error       String?
  /**
   * Admin upload metadata (see ADR 0020). `storageKey` is the internal
   * on-disk filename (the document UUID — never user input, never exposed
   * via the API); `fileName` is the original client name kept for display.
   * URL-registered documents carry `sourceUrl` and a fetched copy on disk.
   */
  fileName    String?   @map("file_name") @db.VarChar(255)
  mimeType    String?   @map("mime_type") @db.VarChar(127)
  sizeBytes   Int?      @map("size_bytes")
  storageKey  String?   @map("storage_key") @db.VarChar(255)
  /** Soft delete: set when an admin removes the document (chunks deleted). */
  deletedAt   DateTime? @map("deleted_at")
  chunks      Chunk[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([productId, source])
  @@index([productId])
  @@index([categoryId])
  @@index([status])
  @@index([locale])
  @@index([deletedAt])
  @@map("documents")
}

model Chunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  String?  @map("product_id") @db.Uuid
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /** Zero-based position of the chunk inside its document. */
  ord        Int
  /** Plain extracted text of the chunk (~300-500 tokens, see AGENTS.md §7). */
  content    String   @db.Text
  /** BCP 47 locale of `content`; drives the full-text regconfig (ADR 0015). */
  locale     String
  /** Denormalized retrieval filters (productId, category, docType, ...). */
  metadata   Json     @default("{}") @db.JsonB
  /**
   * Id of the model that produced the chunk embedding
   * (e.g. `text-embedding-3-small`, ADR 0017; `fake-hash-v1` for offline
   * fixtures). NULL until the chunk is embedded.
   */
  embeddingModel String? @map("embedding_model")
  /** Length of the stored embedding vector (1536 for the default model). */
  embeddingDim Int? @map("embedding_dim")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([documentId, ord])
  @@index([documentId])
  @@index([productId])
  @@index([locale])
  @@index([metadata], type: Gin)
  @@map("chunks")
}

// --- Embedding model switching (Fase 2, reindex) ----------------------------
// Zero-downtime model changes (see AGENTS.md §7 and ADR 0023): retrieval
// always queries the ACTIVE model/column recorded in `RagEmbeddingState`
// (one row, `key = 'active'`), while a background `ReindexJob` fills the
// target column in idempotent batches. The old vector column is never
// dropped in the same task that introduces the new one. Vector columns
// themselves (`embedding`, `embedding_halfvec`, `embedding_v2`) stay owned
// by raw SQL migrations — Prisma has no vector type.

/** Lifecycle of one model-switch reindex. */
enum ReindexStatus {
  RUNNING
  COMPLETED
}

model RagEmbeddingState {
  /** Always `'active'`: this table holds exactly one row. */
  key String @id
  /** Model id currently serving retrieval (e.g. `text-embedding-3-small`). */
  model String
  /** Width of the active vectors; selects the column via the registry. */
  dim Int
  /** Physical `chunks` column holding the active vectors. */
  column String
  /** pgvector cast for query literals (`vector` or `halfvec`). */
  cast String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rag_embedding_state")
}

model ReindexJob {
  id String @id @default(uuid()) @db.Uuid
  /** Model that was ACTIVE when the job started: scopes the activation flip. */
  sourceModel String? @map("source_model")
  /** Incoming model id (from `EMBEDDING_MODEL` at start time). */
  targetModel String @map("target_model")
  /** Incoming width (from `EMBEDDING_DIM` at start time). */
  targetDim Int @map("target_dim")
  /** Registry-resolved column receiving the new vectors. */
  targetColumn String @map("target_column")
  status ReindexStatus @default(RUNNING)
  /** Chunk ids snapshotted at start; batches cover exactly this set. */
  totalChunks Int @map("total_chunks")
  /** Snapshotted chunks confirmed at the target model (incl. skips). */
  processedChunks Int @default(0) @map("processed_chunks")
  /** Snapshotted chunks that errored (retried via `resume`). */
  failedChunks Int @default(0) @map("failed_chunks")
  /** Chunk ids per BullMQ batch (from `EMBEDDING_BATCH_SIZE`). */
  batchSize Int @map("batch_size")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("reindex_jobs")
}
