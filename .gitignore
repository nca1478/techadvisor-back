# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# prisma generated client (reproducible via `npx prisma generate`; lives under src/ so nest build works)
generated/

# test coverage
coverage/

# environment (never commit secrets; see .env.example in later tasks)
.env
.env.*.local
.env.prod

# logs
*.log

# RAG eval reports (generated; the dataset and runner are versioned)
eval/results/*
!eval/results/.gitkeep

# admin-uploaded RAG source files (local disk storage, see ADR 0020)
storage/

# editor / OS
.DS_Store
