# Copy to .env and adjust for local development. Values below are EXAMPLES, not real secrets.
# See README.md for how to start the infrastructure.

# API port (backend listens on 3001)
PORT=3001

# PostgreSQL (matches docker-compose.yml defaults, host port 5433)
DATABASE_URL=postgresql://techadvisor:techadvisor@localhost:5433/techadvisor?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Auth (example only — generate a real secret for local .env, never commit it)
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime in seconds (short-lived, default 15 min)
JWT_ACCESS_EXPIRES_IN_SEC=900

# Refresh token lifetime in seconds (default 30 days)
JWT_REFRESH_EXPIRES_IN_SEC=2592000

# Rate limiting for /auth/* per IP (max requests per window in ms)
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_TTL_MS=60000

# Rate limiting for GET /api/v1/search per IP (public, read-only; every hit
# costs an embedding call plus hybrid SQL, see ADR 0022)
SEARCH_RATE_LIMIT_MAX=60
SEARCH_RATE_LIMIT_TTL_MS=60000

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# Base currency (ISO 4217) and supported currencies (comma-separated ISO 4217 codes)
BASE_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR

# Default locale for UI and content (BCP 47)
DEFAULT_LOCALE=en

# Supported locales (comma-separated BCP 47 codes, must include DEFAULT_LOCALE)
SUPPORTED_LOCALES=en,es

# Expose the OpenAPI JSON document at GET /api/v1/docs-json (set to false in production)
DOCS_ENABLED=true

# Structured JSON request logs ("request completed") on stdout (set to false to silence, keeps x-request-id)
REQUEST_LOGGING_ENABLED=true

# Stripe (test mode only — never use live keys; the API rejects sk_live_* at boot, see ADR 0012)
# Leave unset for local development without payments (POST /api/v1/payments/* returns 503).
STRIPE_SECRET_KEY=sk_test_example
STRIPE_PUBLISHABLE_KEY=pk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example

# Embeddings (provider-agnostic, see ADRs 0016 and 0017; storage is always pgvector)
# Default model: text-embedding-3-small (OpenAI, multilingual es/en, native
# 1536 dims, ~$0.02/1M input tokens) served through any OpenAI-compatible
# /embeddings endpoint. EMBEDDING_DIM must match chunks.embedding vector(1536)
# (pgvector indexed limit: 2000); it is sent as `dimensions` when supported.
# For offline dev/tests use the fake adapter instead (deterministic hash
# vectors, no network): EMBEDDING_PROVIDER=fake with EMBEDDING_MODEL,
# EMBEDDING_API_KEY and EMBEDDING_BASE_URL unset — fake vectors stay labeled
# fake-hash-v1 and must never be persisted under the production model name.
# Alternative model (see ADR 0018): NVIDIA nemotron-3-embed-1b (multilingual
# es/en, native 2048 dims stored as halfvec) via the native `nvidia` provider:
#   EMBEDDING_PROVIDER=nvidia
#   EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
#   EMBEDDING_API_KEY=nvapi-...
#   EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
#   EMBEDDING_DIM=2048
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_RETRY_BASE_DELAY_MS=500
EMBEDDING_RETRY_MAX_DELAY_MS=8000

# Ingestion queue (BullMQ, see ADR 0019). The API process only enqueues;
# the standalone worker (`npm run worker:ingestion`) consumes the queue with
# INGESTION_CONCURRENCY parallel jobs, INGESTION_MAX_ATTEMPTS attempts per
# job and exponential backoff starting at INGESTION_BACKOFF_MS.
INGESTION_MAX_ATTEMPTS=5
INGESTION_BACKOFF_MS=5000
INGESTION_CONCURRENCY=4

# Admin document uploads (local disk storage, see ADR 0020).
# Directory holding uploaded source files (created at boot, gitignored).
# Stored filenames are document UUIDs — never user-supplied names — and no
# filesystem path is ever returned by the API.
DOCUMENTS_DIR=./storage/documents
# Maximum accepted upload size in bytes (1024..10485760; capped by the
# BullMQ job payload limit, see ADR 0020).
DOCUMENTS_MAX_BYTES=10485760
