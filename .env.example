# Copy to .env and adjust for local development. Values below are EXAMPLES, not real secrets.
# See README.md for how to start the infrastructure.

# API port (backend listens on 3001)
PORT=3001

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://techadvisor:techadvisor@localhost:5432/techadvisor?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Auth (example only — generate a real secret for local .env, never commit it)
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# Base currency (ISO 4217) and supported currencies (comma-separated ISO 4217 codes)
BASE_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR

# Default locale for UI and content (BCP 47)
DEFAULT_LOCALE=en
