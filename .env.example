# Copy to .env and adjust for local development. Values below are EXAMPLES, not real secrets.
# See README.md for how to start the infrastructure.

# API SETTINGS ##############################################################################################

# API port (backend listens on 3001)
PORT=3001

# Auth (example only — generate a real secret for local .env, never commit it)
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime in seconds (short-lived, default 15 min)
JWT_ACCESS_EXPIRES_IN_SEC=900

# Refresh token lifetime in seconds (default 30 days)
JWT_REFRESH_EXPIRES_IN_SEC=2592000

# Rate limiting for /auth/* per IP (max requests per window in ms)
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_TTL_MS=60000

# Rate limiting for GET /api/v1/search per IP (public, read-only; every hit
# costs an embedding call plus hybrid SQL, see ADR 0022)
SEARCH_RATE_LIMIT_MAX=60
SEARCH_RATE_LIMIT_TTL_MS=60000

# Rate limiting for POST /api/v1/advisor/product-qa per IP (every hit costs
# retrieval plus one LLM call, see ADR 0025)
ADVISOR_RATE_LIMIT_MAX=30
ADVISOR_RATE_LIMIT_TTL_MS=60000

# Minimum fused RRF score of the best evidence chunk to call the LLM; below
# it the advisor abstains without calling the provider (see ADR 0025)
ADVISOR_ABSTAIN_MIN_SCORE=0.016

# Advisor chat-session history (see ADR 0029): max messages stored per
# session, max characters per message (enforced at the API edge), and age in
# days after which anonymous (guest) sessions are purged by the cleanup job
ADVISOR_SESSION_MAX_MESSAGES=100
ADVISOR_MESSAGE_MAX_LENGTH=2000
ADVISOR_ANON_SESSION_RETENTION_DAYS=30

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# Default locale for UI and content (BCP 47)
DEFAULT_LOCALE=en

# Supported locales (comma-separated BCP 47 codes, must include DEFAULT_LOCALE)
SUPPORTED_LOCALES=en,es

# Expose the OpenAPI JSON document at GET /api/v1/docs-json (set to false in production)
DOCS_ENABLED=true

# Structured JSON request logs ("request completed") on stdout (set to false to silence, keeps x-request-id)
REQUEST_LOGGING_ENABLED=true

# DATABASES ################################################################################################

# PostgreSQL (matches docker-compose.yml defaults, host port 5433)
DATABASE_URL=postgresql://techadvisor:techadvisor@localhost:5433/techadvisor?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379
# Managed Redis (Upstash, see ADR 0065): rediss:// with TLS + auth, e.g.
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Seeder local Supabase
NODE_TLS_REJECT_UNAUTHORIZED=0

# CURRENCY #################################################################################################

# Base currency (ISO 4217) and supported currencies (comma-separated ISO 4217 codes).
# Single-currency operation (USD only): EUR is re-enabled later by setting
# SUPPORTED_CURRENCIES=USD,EUR with no code changes (see ADR 0050).
BASE_CURRENCY=USD
SUPPORTED_CURRENCIES=USD


# STRIPE ###################################################################################################

# Stripe (test mode only — never use live keys; the API rejects sk_live_* at boot, see ADR 0012)
# Leave unset for local development without payments (POST /api/v1/payments/* returns 503).
STRIPE_SECRET_KEY=sk_test_example
STRIPE_PUBLISHABLE_KEY=pk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example

# Optional Stripe API base URL for local development against stripe-mock
# (see ADR 0051). Unset by default (real Stripe test API).
# With `docker compose up` running, set it to talk to the mock instead:
# STRIPE_BASE_URL=http://localhost:12111
STRIPE_BASE_URL=

# EMBEDDINGS LLM ###########################################################################################

# Embeddings (provider-agnostic, see ADRs 0016 and 0017; storage is always pgvector)
# Default model: text-embedding-3-small (OpenAI, multilingual es/en, native
# 1536 dims, ~$0.02/1M input tokens) served through any OpenAI-compatible
# /embeddings endpoint. EMBEDDING_DIM must match chunks.embedding vector(1536)
# (pgvector indexed limit: 2000); it is sent as `dimensions` when supported.
# For offline dev/tests use the fake adapter instead (deterministic hash
# vectors, no network): EMBEDDING_PROVIDER=fake with EMBEDDING_MODEL,
# EMBEDDING_API_KEY and EMBEDDING_BASE_URL unset — fake vectors stay labeled
# fake-hash-v1 and must never be persisted under the production model name.
# Alternative model (see ADR 0018): NVIDIA nemotron-3-embed-1b (multilingual
# es/en, native 2048 dims stored as halfvec) via the native `nvidia` provider:
#   EMBEDDING_PROVIDER=nvidia
#   EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
#   EMBEDDING_API_KEY=nvapi-...
#   EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
#   EMBEDDING_DIM=2048
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_RETRY_BASE_DELAY_MS=500
EMBEDDING_RETRY_MAX_DELAY_MS=8000

# LLM GENERATION ###########################################################################################

# LLM generation (provider-agnostic, see ADR 0024; default `fake` boots offline)
# `fake`: scripted responses for tests/dev, no network — LLM_MODEL optional
# (labels results `fake-llm-v1`).
# `openai-compatible`: any API with the OpenAI /chat/completions format
# (OpenAI, OpenRouter, vLLM, Ollama, ...) incl. SSE streaming; requires
# LLM_BASE_URL + LLM_MODEL (+ LLM_API_KEY unless the server needs none).
# `openai-responses`: any API with the OpenAI Responses format
# (POST /responses): OpenAI, Azure OpenAI, Vercel AI Gateway, opencode-go
# Zen, ...; requires LLM_BASE_URL + LLM_MODEL (+ LLM_API_KEY). Example for
# Muse Spark via the opencode Go plan:
# LLM_PROVIDER=openai-responses
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=muse-spark-1.3-contributor
# LLM_API_KEY=<zen-api-key>
# NOTE: max_output_tokens covers reasoning + visible tokens on thinking
# models, so raise LLM_MAX_TOKENS (e.g. 4096) when using one. With
# `openai-responses` you can also lower the thinking cost with
# LLM_REASONING_EFFORT=minimal|low|medium|high (sent only when set;
# non-reasoning models reject it, so leave it empty for them).
# `anthropic`: native Messages API via the official @anthropic-ai/sdk;
# requires LLM_MODEL + LLM_API_KEY; LLM_BASE_URL is an optional override
# (defaults to https://api.anthropic.com). Only adapters/ may import the SDK.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=500
LLM_RETRY_MAX_DELAY_MS=8000
LLM_MAX_TOKENS=1024
# LLM_REASONING_EFFORT=minimal

# INGESTION QUEUE ##########################################################################################

# Ingestion queue (BullMQ, see ADR 0019). The API process only enqueues;
# the standalone worker (`npm run worker:ingestion`) consumes the queue with
# INGESTION_CONCURRENCY parallel jobs, INGESTION_MAX_ATTEMPTS attempts per
# job and exponential backoff starting at INGESTION_BACKOFF_MS.
INGESTION_MAX_ATTEMPTS=5
INGESTION_BACKOFF_MS=5000
INGESTION_CONCURRENCY=4

# ADMIN DOCUMENT UPLOADS ###################################################################################

# Admin document uploads (see ADRs 0020 and 0071).
# Local driver (development default): directory holding uploaded source
# files, created at boot with mkdir -p, gitignored. Stored filenames are
# document UUIDs — never user-supplied names — and no filesystem path is
# ever returned by the API. No Supabase bucket is created in this mode.
DOCUMENTS_DIR=./storage/documents
DOCUMENTS_DRIVER=local
# Supabase driver (production): private bucket + prefix folder created at
# boot (bucket idempotent, public:false; prefix storage/documents via a
# .keep placeholder — Supabase folders are virtual). Keys stay
# <uuid>.bin, stored as <prefix>/<uuid>.bin objects.
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-never-exposed-to-clients
# SUPABASE_STORAGE_BUCKET=documents
# SUPABASE_STORAGE_PREFIX=storage/documents
# Maximum accepted upload size in bytes (1024..10485760; capped by the
# BullMQ job payload limit, see ADR 0020).
DOCUMENTS_MAX_BYTES=10485760

# CUSTOMER REVIEWS #############################################################################################

# Pros/cons summaries over PUBLISHED reviews (see ADR 0037). The cached
# summary row is absent while a product has fewer PUBLISHED reviews than
# REVIEW_SUMMARY_MIN_REVIEWS; every moderation change touching PUBLISHED
# re-runs the refresh inline.
REVIEW_SUMMARY_MIN_REVIEWS=3
# Published reviews ingested per product into one REVIEW document (cap bounds
# the prompt/queue payload; newest first).
REVIEW_INGESTION_MAX_REVIEWS=20

# AI OBSERVABILITY ###################################################################################

# Metadata-only log of every embedding/LLM/retrieval call (see ADR 0039).
# Rows never store prompts, questions, answers or any user content — only
# type, provider, model, latency, token counts, estimated cost, status,
# error code and optional session id.
# Days rows are kept before the admin cleanup trigger purges them.
AI_CALL_LOG_RETENTION_DAYS=90
# Optional per-1k-token USD tariffs for the telemetry `estimated_cost` column
# (never billing; 0 = tariff unset, cost stored as NULL).
AI_COST_LLM_INPUT_PER_1K=0
AI_COST_LLM_OUTPUT_PER_1K=0
AI_COST_EMBEDDING_PER_1K=0


